PROJECT_NAME=PayResQ
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings
# Set DATABASE_URL to sqlite+aiosqlite:///./payresq_dev.db for zero-config local development,
# or set to postgresql+asyncpg://payresq:payresq_pass@localhost:5432/payresq_db for PostgreSQL.
POSTGRES_USER=payresq
POSTGRES_PASSWORD=payresq_pass
POSTGRES_DB=payresq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./payresq_dev.db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider ("fake" for development/tests, "openai" for OpenAI, "gemini" for Google Gemini)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_TIMEOUT_SECONDS=30

# Agent / Policy Configuration
AGENT_CONFIDENCE_THRESHOLD=0.6
MAX_AUTOMATIC_RETRIES=3
MAX_AUTOMATIC_RECOVERY_AMOUNT=50000.0

# Recovery Worker
RECOVERY_QUEUE_NAME=recovery:jobs
RECOVERY_DEAD_LETTER_KEY=recovery:dead
RECOVERY_WORKER_POLL_INTERVAL=5
RECOVERY_MAX_JOB_RETRIES=3
