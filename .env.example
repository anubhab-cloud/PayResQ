PROJECT_NAME=PayResQ
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings
POSTGRES_USER=payresq
POSTGRES_PASSWORD=payresq_pass
POSTGRES_DB=payresq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://payresq:payresq_pass@localhost:5432/payresq_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider ("fake" for development/tests, "openai" for production)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT_SECONDS=30

# Agent / Policy Configuration
AGENT_CONFIDENCE_THRESHOLD=0.6
MAX_AUTOMATIC_RETRIES=3
MAX_AUTOMATIC_RECOVERY_AMOUNT=50000.0

# Recovery Worker
RECOVERY_QUEUE_NAME=recovery:jobs
RECOVERY_DEAD_LETTER_KEY=recovery:dead
RECOVERY_WORKER_POLL_INTERVAL=5
RECOVERY_MAX_JOB_RETRIES=3
